# USDT Hot Wallet Configuration
# The hot wallet handles ALL on-chain USDT withdrawals.
# On backend startup, the hot wallet Tron address is printed to console.
# Fund that address with: min 500 TRX (gas) + USDT liquidity before going live.
PRAQEN_HOT_WALLET_IDENTIFIER=praqen_hot_wallet_main
HOT_WALLET_MIN_TRX=100
HOT_WALLET_TRX_SWEEP=20

# Tiered USDT withdrawal fee: flat for small amounts, % for large
# $1–$50  → USDT_WITHDRAWAL_FEE_FLAT  (default $4.00)
# $50+    → USDT_WITHDRAWAL_FEE_PERCENT (default 4%)
# Minimum send amount (before fee): USDT_MIN_SEND (default $5)
USDT_WITHDRAWAL_FEE_FLAT=4.0
USDT_WITHDRAWAL_FEE_PERCENT=0.04
USDT_MIN_SEND=5