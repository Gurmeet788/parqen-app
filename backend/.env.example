# PRAQEN Backend Environment Variables

# Supabase Configuration
SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=your-supabase-anon-key

# JWT Configuration (Change this to a strong secret in production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-very-important

# Server Configuration
PORT=5000
NODE_ENV=development

# Blockchain APIs (Add later for real Bitcoin)
# BLOCKCHAIN_COM_API_KEY=your_api_key
# MEMPOOL_API_URL=https://mempool.space/api

# Email Configuration (Add later for real emails)
# SENDGRID_API_KEY=your_sendgrid_key
# ADMIN_EMAIL=admin@praqen.com


# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-id

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=your-smtp-from

AFRICASTALKING_USERNAME=your-africatalking-username
AFRICASTALKING_API_KEY=your-africatalking-api-key
AFRICASTALKING_SENDER_ID=your-africatalking-sender-id

FRONTEND_URL=http://localhost:3000